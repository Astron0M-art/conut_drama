[Unit]
Description=字数统计 · 打回编剧重申工作台 (count-drama)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/conut_drama
EnvironmentFile=/etc/count-drama.env
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=3

# 加固：临时随机用户（非 root、不可登录），文件系统只读，只允许绑定低位端口
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

# 服务器上还有别的服务，给本服务内存封顶
MemoryMax=1G

[Install]
WantedBy=multi-user.target
